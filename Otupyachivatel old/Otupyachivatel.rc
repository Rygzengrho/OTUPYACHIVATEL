    PUSHBUTTON      "Да ну &в пизду :(",IDCANCEL,228,264,66,16
    EDITTEXT        IDC_EDIT3,6,180,294,62,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | ES_WANTRETURN
    LTEXT           "А тут текст с котами:",IDC_STATIC,6,168,75,8
    PUSHBUTTON      "&Открыть",IDC_BUTTONOPENFILE,6,264,66,19,0,0,HIDC_BUTTONOPENFILE
    LTEXT           "Открыть другой файл конфигурации",IDC_STATIC,6,246,72,18
    GROUPBOX        "Функции",IDC_STATIC,150,246,150,36
    CONTROL         "Выкл",IDC_ClipbMode1,"Button",BS_AUTORADIOBUTTON | WS_GROUP,12,300,33,10
    CONTROL         "Текст",IDC_ClipbMode2,"Button",BS_AUTORADIOBUTTON,12,312,35,10
    CONTROL         "Текст с котами",IDC_ClipbMode3,"Button",BS_AUTORADIOBUTTON,12,324,67,10
    CONTROL         "&Поверх унылых окон",IDC_CheckTopmost,"Button",BS_AUTOCHECKBOX | BS_PUSHLIKE | BS_MULTILINE | WS_TABSTOP,78,264,66,19
    GROUPBOX        "Режим генератора лучей поноса",IDC_STATIC,150,288,150,48
    CONTROL         "Выкл",IDC_CheckZlogenMode,"Button",BS_AUTOCHECKBOX | BS_PUSHLIKE | WS_TABSTOP,156,300,24,18
